    he had heart surgery around 3 years ago.","parentUIDs":[31],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":35}],"EditorInfo":{"isRoot":false,"xPos":953.0015,"yPos":1943.66772},"ID":34,"ParamActions":[],"TMPFontGUID":null,"Text":"He
    used to go to a cardiologist but when he got better he stopped.","parentUIDs":[33],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":37}],"EditorInfo":{"isRoot":false,"xPos":964.00116,"yPos":2121.66846},"ID":36,"ParamActions":[],"TMPFontGUID":null,"Text":"He
    smokes around a pack a day and drinks occasionally.","parentUIDs":[35],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":39}],"EditorInfo":{"isRoot":false,"xPos":986.0026,"yPos":2308.65869},"ID":38,"ParamActions":[],"TMPFontGUID":null,"Text":"They
